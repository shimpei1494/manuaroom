{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "manuaroom",
  // TanStack Start のサーバーエントリをそのまま Worker として使う
  "main": "@tanstack/react-start/server-entry",
  "compatibility_date": "2026-09-01",
  // TanStack Start が AsyncLocalStorage などの Node API を使い、
  // OpenAI SDK と PDF の base64 化で Buffer を使うため有効にする
  "compatibility_flags": ["nodejs_compat"],
  // Cloudflare Access (docs/deployment.md)。vp dev では使わない
  "vars": {
    // Zero Trust のチームドメイン (例: "family.cloudflareaccess.com")
    "ACCESS_TEAM_DOMAIN": "",
    // Access アプリケーションの AUD タグ
    "ACCESS_AUD": "",
    // Access を通過した家族全員で共有するユーザー ID (ADR 0005)
    "APP_USER_ID": "family",
  },
  "observability": {
    "enabled": true,
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "manuaroom",
      // `wrangler d1 create manuaroom` の出力に置き換える（ローカル開発はこのままで動く）
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "drizzle",
    },
  ],
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "manuaroom-manuals",
    },
  ],
}

{
  "name": "tanstack-start-start",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vp build",
    "cf-typegen": "wrangler types --strict-vars=false",
    "check": "vp check",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "wrangler d1 migrations apply manuaroom --local",
    "db:migrate:remote": "wrangler d1 migrations apply manuaroom --remote",
    "deploy": "vp build && wrangler deploy",
    "dev": "vp dev",
    "doctor": "react-doctor . --verbose --yes --no-lint",
    "e2e": "playwright test",
    "e2e:server": "rm -rf .wrangler/e2e-state && wrangler d1 migrations apply manuaroom --local --persist-to .wrangler/e2e-state && E2E=1 vp dev --strictPort",
    "fix": "vp check --fix",
    "knip": "knip",
    "preview": "vp preview",
    "test": "vp test",
    "type-check": "vp check --no-lint"
  },
  "dependencies": {
    "@mantine/core": "^9.7.3",
    "@mantine/dates": "^9.7.3",
    "@mantine/form": "^9.7.3",
    "@mantine/hooks": "^9.7.3",
    "@mantine/modals": "^9.7.3",
    "@mantine/notifications": "^9.7.3",
    "@tanstack/react-router": "^1.170.46",
    "@tanstack/react-start": "^1.169.4",
    "dayjs": "^1.11.23",
    "drizzle-orm": "^0.45.4",
    "jose": "^6.2.13",
    "openai": "^6.39.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.65.0",
    "@playwright/test": "1.63.0",
    "@rolldown/plugin-babel": "^0.2.4",
    "@tanstack/react-router-devtools": "^1.167.2",
    "@types/node": "^25.9.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "babel-plugin-react-compiler": "^1.0.0",
    "better-typescript-lib": "^2.12.0",
    "drizzle-kit": "^0.31.11",
    "knip": "^6.42.1",
    "postcss": "^8.5.31",
    "postcss-preset-mantine": "^1.18.0",
    "postcss-simple-vars": "^7.0.1",
    "react-doctor": "^0.1.6",
    "vite": "npm:@voidzero-dev/vite-plus-core@^0.1.20",
    "vite-plus": "latest",
    "wrangler": "^4.152.0"
  },
  "packageManager": "pnpm@10.32.1",
  "pnpm": {
    "overrides": {
      "vite": "npm:@voidzero-dev/vite-plus-core@latest",
      "vitest": "npm:@voidzero-dev/vite-plus-test@latest"
    },
    "onlyBuiltDependencies": [
      "esbuild",
      "workerd"
    ]
  }
}
